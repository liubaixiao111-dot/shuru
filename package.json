{
  "name": "shuru",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "postinstall": "prisma generate",

    "electron:dev": "concurrently -k -n next,elec -c green,cyan \"next dev\" \"wait-on -t 60000 tcp:127.0.0.1:3000 && tsc -p tsconfig.electron.json && cross-env ELECTRON_IS_DEV=1 electron dist-electron/main.js\"",
    "electron:build": "next build && tsc -p tsconfig.electron.json && node scripts/copy-resources.mjs",
    "electron:dist": "npm run electron:build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "next": "15.5.29",
    "openai": "4.104.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.15.30",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "autoprefixer": "10.4.21",
    "concurrently": "9.1.0",
    "cross-env": "7.0.3",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "wait-on": "8.0.1"
  }
}
